DATABASE_URL="postgresql://site_ticket:site_ticket@localhost:5432/site_ticket?schema=public"
# Required. Generate a real secret, e.g.: openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN="8h"
PORT=3001
# Required. Comma-separated list of allowed frontend origins (no wildcard fallback).
FRONTEND_URL="http://localhost:3000"
ADMIN_EMAIL="admin@site-ticket.local"
ADMIN_PASSWORD="Admin1234!"
# Reference data (roles, ticket types/statuses) + the admin account always seed on boot —
# the app doesn't function without them. Set this to "true" only to ALSO seed the fake
# Marrakech demo accounts/chantiers/tickets (dev/staging only — never in real production).
SEED_DEMO_DATA="false"
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="SiteTicket <no-reply@site-ticket.local>"

# File storage (avatars, ticket attachments, plans, knowledge base files).
# Leave all four empty/unset to use local disk (./uploads) — the default for local dev.
# Set all four to switch to Cloudflare R2 (S3-compatible) — partial config fails startup.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT=""
R2_BUCKET_NAME=""